# =============================================================================
# HireLoop — API Environment Variables
# =============================================================================
# Copy to apps/api/.env and fill in values.
# NEVER commit the filled-in .env file to version control.

# --- Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=anon-public-key
SUPABASE_SERVICE_KEY=service-role-key
SUPABASE_SECRET_KEY=your-jwt-secret

# --- Email (Brevo / SendinBlue) ---
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM=noreply@yourdomain.com
BREVO_FROM_NAME=HireLoop

# --- AI Models ---
GEMINI_API_KEY=your-gemini-api-key
MODEL=gemini-2.0-flash-live-preview-001
SCORING_MODEL=gemini-2.5-flash-001
STT_MODEL=gemini-2.5-flash-001
TTS_MODEL=gemini-2.5-flash-preview-tts-001
TTS_VOICE_EN=Kore

# --- App ---
APP_URL=http://localhost:3000
PORT=8000

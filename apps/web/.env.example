NEXT_PUBLIC_API_URL='http://localhost:8001'
NEXT_PUBLIC_APP_URL='http://localhost:3000'

# Email (Resend) — required for admin "Regenerate & send link"
RESEND_API_KEY=''
RESEND_FROM=''

# Google OAuth — enable in Supabase Dashboard → Authentication → Providers → Google
# Add redirect URL: http://127.0.0.1:3003/auth/callback (and your production URL)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=''
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=''

# Server-only — Dashboard → Settings → API Keys → Secret key (sb_secret_...)
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead
SUPABASE_SECRET_KEY=''

# Must match apps/api/.env INTERVIEW_INTERNAL_SECRET (pre-render question TTS on save)
INTERVIEW_INTERNAL_SECRET=''
